# Copy this file to .env.local and fill in the values (Supabase: Project Settings -> API).
# .env.local is git-ignored. NEVER put the service_role key in any VITE_ variable:
# everything that starts with VITE_ is copied into the public browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
VITE_PAYMENT_PROVIDER=mock
